  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Start Project",
      "preLaunchTask": "Start Project",
      "command": "docker compose -f n8n/compose.yml ps --format \"table {{.Name}}\\t{{.Ports}}\"",
      "postDebugTask": "Stop Project"
    },
    {
      "type": "editor-browser",
      "request": "launch",
      "name": "Open n8n",
      "url": "http://localhost:5678",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
